*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

.idea/
.kotlin/

*.snap
*.sql

*.wav
*.opus

google-services.json
app/linux/**
.DS_Store
# Android 签名材料（绝不提交）
/keystore
/keystore.jks
*.keystore

# Generate Signed APK 的输出目录
/app/fdroid/

# 音效资源需要随仓库分发（Android: res/raw, 桌面: composeResources/files/sounds）
!core/src/androidMain/res/raw/*.wav
!core/src/commonMain/composeResources/files/sounds/*.wav

# 汉化后的词典数据库随仓库分发（构建 app 必需）
!core/src/commonMain/composeResources/files/kanji-dojo-data-base-v15.sql

# SQL 翻译工作区（数据库 / 进度 / 备份，不进仓库）
/SQL翻译中/

# 本地交接文档（不进仓库）
/TTS-HANDOFF.md

# VOICEVOX 运行时资源（约 180MB，用 tools/voicevox/fetch-runtime.ps1 组装，不进仓库）
/tools/voicevox/runtime/

# Android 版 VOICEVOX CORE（构建依赖，要随仓库分发；上面的 *.aar 规则会误伤）
!core/libs/voicevoxcore-android-0.17.0.aar
